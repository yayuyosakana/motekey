// Secrets.xcconfig.template
//
// このファイルをコピーして `Secrets.xcconfig` にリネームし、
// 実際の API キーを入力してください。
// Secrets.xcconfig は .gitignore に追加済みのためコミットされません。
//
// コピーコマンド:
//   cp Config/Secrets.xcconfig.template Config/Secrets.xcconfig

// 用途別に4キーを割り当てる
GEMINI_API_KEY_TEXT_HABIT = ここにテキストハビット抽出用キー
GEMINI_API_KEY_VISION_CONTEXT = ここに画面文脈抽出用キー
GEMINI_API_KEY_ASK_USER_QUESTION = ここに質問生成用キー
GEMINI_API_KEY_REPLY_GENERATION = ここに返信生成用キー

// 後方互換（専用キー未設定時のみ利用）
GEMINI_API_KEY = ここに共通フォールバックキー（任意）
